---
import { ArrowUpIcon, ChevronUpIcon } from "@primer/octicons-react"
---

<div
  id="back-to-top-btn-container"
  class:list={[
    "fixed inset-e-4 bottom-8 z-50",
    "sm:sticky sm:inset-e-auto sm:float-end",
    "translate-y-14 opacity-0 transition duration-500",
  ]}
>
  <button
    onclick="document.documentElement.scrollTop = 0"
    type="button"
    class:list={[
      "group relative bg-background px-2 py-1",
      "size-14 rounded-full shadow-xl",
      "sm:h-8 sm:w-fit sm:rounded-md sm:shadow-none sm:focus-visible:rounded-none",
      "sm:bg-background/35 sm:bg-clip-padding sm:backdrop-blur-lg",
    ]}
  >
    <span
      class="absolute inset-0 -z-10 block size-14 scale-110 rounded-full bg-transparent sm:hidden sm:h-8 sm:rounded-md"
    ></span>
    <ChevronUpIcon className="inline-block size-5 sm:hidden" />
    <span class="sr-only text-sm group-hover:text-accent sm:not-sr-only">
      <ArrowUpIcon className="inline-block size-4" />
      Back To Top
    </span>
  </button>
</div>

<script>
  import { getArticleProgress } from "@/utils/client"

  let lastVisible: boolean
  function handleScroll() {
    const btnContainer = document.querySelector("#back-to-top-btn-container")
    const progressIndicator = btnContainer?.querySelector("button > span") as HTMLElement | null

    const percent = getArticleProgress()

    progressIndicator?.style.setProperty(
      "background-image",
      `conic-gradient(var(--accent), var(--accent) ${percent}%, transparent ${percent}%)`
    )

    const isVisible = percent > 20

    if (isVisible !== lastVisible) {
      btnContainer?.classList.toggle("opacity-100", isVisible)
      btnContainer?.classList.toggle("translate-y-0", isVisible)
      btnContainer?.classList.toggle("opacity-0", !isVisible)
      btnContainer?.classList.toggle("translate-y-14", !isVisible)
      lastVisible = isVisible
    }
  }

  document.addEventListener("scroll", () => {
    handleScroll()
  })
</script>
