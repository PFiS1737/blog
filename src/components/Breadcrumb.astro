---
const breadcrumbList = Astro.url.pathname.split("/").slice(1)

if (breadcrumbList[0] === "posts") {
  breadcrumbList.splice(0, 2, `Posts (page ${breadcrumbList[1] || 1})`)
}

if (breadcrumbList[0] === "tags" && !Number.isNaN(Number(breadcrumbList[2]))) {
  breadcrumbList.splice(
    1,
    3,
    `${breadcrumbList[1]} ${Number(breadcrumbList[2]) === 1 ? "" : `(page ${breadcrumbList[2]})`}`
  )
}
---

<nav class="mx-auto mt-8 mb-2 w-full max-w-app px-4" aria-label="breadcrumb">
  <ul class="font-light [&>li]:inline">
    <li>
      <a href="/" class="opacity-80">Home</a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) =>
        index + 1 < breadcrumbList.length ? (
          <li>
            <a href={`/${breadcrumb}`} class="capitalize opacity-80">
              {breadcrumb}
            </a>
            <span aria-hidden="true" class="opacity-80">
              &raquo;
            </span>
          </li>
        ) : (
          <li>
            <span class:list={["capitalize opacity-80", { lowercase: index > 0 }]} aria-current="page">
              {decodeURIComponent(breadcrumb)}
            </span>
          </li>
        )
      )
    }
  </ul>
</nav>
