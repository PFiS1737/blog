---
import { getPath, type Post, renderPost, slugifyStr } from "@/utils"
import PostInfo from "./PostInfo.astro"

export interface Props extends Post {
  variant?: "h2" | "h3"
}

const { variant = "h2", id, filePath } = Astro.props

const { title, description, publishDate, updateDate, readingTime } = await renderPost(Astro.props)

const transitionName = slugifyStr(title)
---

<li class="my-6">
  <a
    class="inline-block text-lg font-medium text-accent decoration-dashed underline-offset-4 focus-visible:no-underline focus-visible:underline-offset-0"
    href={getPath(id, filePath)}
  >
    {
      variant === "h2" ? (
        <h2 class="text-lg font-medium decoration-dashed hover:underline" transition:name={transitionName}>
          {title}
        </h2>
      ) : (
        <h3 class="text-lg font-medium decoration-dashed hover:underline" transition:name={transitionName}>
          {title}
        </h3>
      )
    }
  </a>
  <PostInfo {publishDate} {readingTime} {updateDate} />
  <p class="text-base">{description}</p>
</li>
