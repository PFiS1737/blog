---
import { format, formatISO } from "date-fns"

export interface Props {
  publishDate: string | Date
  updateDate: string | Date | undefined | null
  size?: "sm" | "lg"
  class?: string
}

const {
  publishDate,
  updateDate,
  size = "sm",
  class: className = "",
} = Astro.props

const isModified = updateDate && updateDate > publishDate

const date = isModified ? updateDate : publishDate
---

<div class:list={["flex items-center gap-x-2 opacity-80", className]}>
  {
    isModified && (
      <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
        Updated:
      </span>
    )
  }
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={formatISO(date)}>{format(date, "d MMM, yyyy")}</time
  >
</div>
