---
export interface Props {
  id?: string
  href: string
  class?: string
  title?: string
  disabled?: boolean
}

const { id, href, class: className = "", title, disabled = false } = Astro.props
---

{
  disabled ? (
    <span aria-disabled={disabled} id={id} class:list={["group inline-block", className]} title={title}>
      <slot />
    </span>
  ) : (
    // biome-ignore lint/a11y/useValidAnchor: https://github.com/biomejs/biome/issues/11496
    <a class:list={["group inline-block hover:text-accent", className]} {href} id={id} title={title}>
      <slot />
    </a>
  )
}
