---
import { ArrowLeftIcon, ArrowRightIcon } from "@primer/octicons-react"
import type { Page } from "astro"
import type { Post } from "@/utils"
import LinkButton from "./LinkButton.astro"

export interface Props {
  page: Page<Post>
}

const { page } = Astro.props
---

{
  page.lastPage > 1 && (
    <nav aria-label="Pagination" class="mt-auto mb-8 inline-flex justify-center">
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={["me-4 select-none inline-flex items-center gap-1", { "opacity-50": !page.url.prev }]}
      >
        <ArrowLeftIcon className="size-5 rtl:rotate-180" />
        Prev
      </LinkButton>
      {page.currentPage} / {page.lastPage}
      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={["ms-4 select-none inline-flex items-center gap-1", { "opacity-50": !page.url.next }]}
      >
        Next
        <ArrowRightIcon className="size-5 rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
