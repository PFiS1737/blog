---
import { RelativeTime } from "@primer/react"
import clsx from "clsx"
import type { ReadTimeResults } from "reading-time"

export interface Props {
  publishDate: Date
  updateDate: Date | undefined | null
  readingTime: ReadTimeResults
  size?: "sm" | "lg"
  class?: string
}

const { publishDate, updateDate, readingTime, size = "sm", class: className = "" } = Astro.props

const isModified = updateDate && updateDate > publishDate

const date = isModified ? updateDate : publishDate

const textSizeClassList = ["text-sm", { "sm:text-base": size === "lg" }]
---

<div class:list={["flex items-center gap-x-2 opacity-80", className]}>
  {isModified && <span class:list={textSizeClassList}>Updated:</span>}
  <RelativeTime className={clsx(textSizeClassList)} date={date} prefix="" client:load />
  <span class:list={textSizeClassList}>|</span>
  <span class:list={textSizeClassList}>{readingTime.text}</span>
</div>
