---
import type { ReadTimeResults } from "reading-time"

export interface Props {
  publishDate: Date
  updateDate: Date | undefined | null
  readingTime: ReadTimeResults
  size?: "sm" | "lg"
  class?: string
}

const { publishDate, updateDate, readingTime, size = "sm", class: className = "" } = Astro.props

const isModified = updateDate && updateDate > publishDate

const date = isModified ? updateDate : publishDate
---

<div
  class:list={["flex items-center gap-x-2 text-muted-foreground text-sm", { "sm:text-base": size === "lg" }, className]}
>
  {isModified && <span>Updated:</span>}
  <relative-time datetime={date.toISOString()} prefix="">{date.toLocaleString()}</relative-time>
  <span>|</span>
  <span>{readingTime.text}</span>
</div>

<script>
  import "@github/relative-time-element"
</script>
