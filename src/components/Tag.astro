---
import { HashIcon } from "@primer/octicons-react"

export interface Props {
  tag: string
  tagName: string
  size?: "sm" | "lg"
}

const { tag, tagName, size = "sm" } = Astro.props
---

<li
  class:list={[
    "group inline-block group-hover:cursor-pointer",
    size === "sm" ? "my-1 underline-offset-4" : "mx-1 my-3 underline-offset-8",
  ]}
>
  <a
    href={`/tags/${tag}`}
    transition:name={tag}
    class:list={[
      "relative pe-4 group-hover:text-accent",
      size === "sm" ? "text-sm" : "text-lg",
    ]}
  >
    <HashIcon
      className={`inline-block opacity-80 mr-1 ${size === "sm" ? "size-3.5" : "size-4.5"}`}
    /><span class="underline decoration-dashed">{tagName}</span>
  </a>
</li>
