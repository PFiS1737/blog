---
import { ChevronLeftIcon, ChevronRightIcon } from "@primer/octicons-react"
import BackToTopButton from "@/components/BackToTopButton.astro"
import PostInfo from "@/components/PostInfo.astro"
import Tag from "@/components/Tag.astro"
import Layout from "@/layouts/Layout.astro"
import config from "@/site.config"
import { getPath, type Post, renderPost, slugifyStr } from "@/utils"

export interface Props {
  post: Post
  posts: Post[]
}

const { post, posts } = Astro.props

const { title, author, description, publishDate, updateDate, tags, Content, readingTime } = await renderPost(post)

const layoutProps = {
  author,
  description,
  publishDate,
  title: `${title} | ${config.title}`,
  updateDate,
}

const transitionName = slugifyStr(title)

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  filePath,
  id,
  title,
}))

const currentPostIndex = allPosts.findIndex((a) => a.id === post.id)

const prevPost = currentPostIndex === 0 ? null : allPosts[currentPostIndex - 1]
const nextPost = currentPostIndex === allPosts.length ? null : allPosts[currentPostIndex + 1]
---

<Layout {...layoutProps}>
  <main class="mx-auto w-full max-w-app px-4 pb-8 mt-8" data-pagefind-body id="main-content">
    <h1 class="inline-block text-2xl font-bold text-accent sm:text-3xl" transition:name={transitionName}>
      {title}
    </h1>
    <div class="my-2 flex items-center gap-2">
      <PostInfo {publishDate} {readingTime} size="lg" {updateDate} />
    </div>
    <article class="app-prose mx-auto mt-8 max-w-app" id="article">
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    <ul class="my-8">
      {tags.map((tag) => <Tag tag={slugifyStr(tag)} tagName={tag} />)}
    </ul>

    <BackToTopButton />

    <hr class="my-8 sm:mt-24 border-dashed" />

    <!-- Previous/Next Post Buttons -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2" data-pagefind-ignore>
      {
        prevPost && (
          <a class="flex w-full gap-1 hover:opacity-75" href={getPath(prevPost.id, prevPost.filePath)}>
            <ChevronLeftIcon className="inline-block flex-none rtl:rotate-180" size={24} />
            <div>
              <span>Previous Post</span>
              <div class="text-sm text-accent/85">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
            href={getPath(nextPost.id, nextPost.filePath)}
          >
            <div>
              <span>Next Post</span>
              <div class="text-sm text-accent/85">{nextPost.title}</div>
            </div>
            <ChevronRightIcon className="inline-block flex-none rtl:rotate-180" size={24} />
          </a>
        )
      }
    </div>
  </main>
</Layout>

<script>
  // Go to page start after page swap
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({
      behavior: "instant",
      left: 0,
      top: 0,
    })
  )
</script>
