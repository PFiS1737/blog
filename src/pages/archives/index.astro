---
import { getCollection } from "astro:content"
import Card from "@/components/Card.astro"
import Layout from "@/layouts/Layout.astro"
import Main from "@/layouts/Main.astro"
import config from "@/site.config"
import { getPostsByGroupCondition } from "@/utils"

const posts = await getCollection("posts")

const MONTHS = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
]
---

<Layout title={`Archives | ${config.title}`}>
  <Main pageTitle="Archives" pageDesc="All the articles I've archived.">
    {
      [
        ...getPostsByGroupCondition(posts, (post) =>
          post.data.publishDate.getFullYear()
        ).entries(),
      ]
        .sort(([yearA], [yearB]) => yearB - yearA)
        .map(([year, yearGroup]) => (
          <div>
            <span class="text-2xl font-bold">{year}</span>
            {[
              ...getPostsByGroupCondition(
                yearGroup,
                (post) => post.data.publishDate.getMonth() + 1
              ).entries(),
            ]
              .sort(([monthA], [monthB]) => monthB - monthA)
              .map(([month, monthGroup]) => (
                <div class="flex flex-col sm:flex-row">
                  <div class="mt-6 min-w-36 text-lg sm:my-6">
                    <span class="font-bold">{MONTHS[month - 1]}</span>
                  </div>
                  <ul>
                    {monthGroup
                      .sort(
                        (a, b) =>
                          b.data.publishDate.getTime() -
                          a.data.publishDate.getTime()
                      )
                      .map((post) => (
                        <Card {...post} />
                      ))}
                  </ul>
                </div>
              ))}
          </div>
        ))
    }
  </Main>
</Layout>
