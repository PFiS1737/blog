---
import { getCollection, getEntry, render } from "astro:content"
import { ArrowRightIcon, RssIcon } from "@primer/octicons-react"
import Card from "@/components/Card.astro"
import Hr from "@/components/Hr.astro"
import LinkButton from "@/components/LinkButton.astro"
import Socials from "@/components/Socials.astro"
import Layout from "@/layouts/Layout.astro"
import config from "@/site.config"
import { getSortedPosts } from "@/utils"

const main = await getEntry("pages", "main")

if (!main) {
  throw new Error("Missing content entry: `main.md` or `main.mdx` in `src/content/pages/`")
}

const { Content } = await render(main)

const posts = getSortedPosts(await getCollection("posts"))
const featuredPosts = posts.filter(({ data }) => data.featured)
const recentPosts = posts.filter(({ data }) => !data.featured)
---

<Layout>
  <main id="main-content">
    <section class="pt-8 pb-6" id="hero">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">Mingalaba</h1>
      <a aria-label="rss feed" class="inline-block" href="/rss.xml" target="_blank" title="RSS Feed">
        <RssIcon className="ms-1 text-accent stroke-accent stroke-1 rtl:-rotate-90" size={24} />
        <span class="sr-only">RSS Feed</span>
      </a>
      <div class="text-base [&_p]:mb-4 [&_a]:text-accent [&_.octicon]:mb-0.5">
        <Content />
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center">
        <div class="me-3 mb-1 whitespace-nowrap sm:mb-0 text-base">Social Links:</div>
        <Socials />
      </div>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section class="pt-12 pb-6" id="featured">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map((post) => (
                <Card variant="h3" {...post} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section class="pt-12 pb-6" id="recent-posts">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (post, index) => index < config.appearance.recentPostsCount && <Card variant="h3" {...post} />
            )}
          </ul>
        </section>
      )
    }

    <div class="mt-auto mb-8 text-center">
      <LinkButton class="select-none inline-flex items-center gap-1" href="/posts">
        All Posts
        <ArrowRightIcon className="size-5 rtl:rotate-180" />
      </LinkButton>
    </div>
  </main>
</Layout>
