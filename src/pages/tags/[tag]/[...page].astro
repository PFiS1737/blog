---
import { getCollection } from "astro:content"
import type { GetStaticPathsOptions } from "astro"
import Card from "@/components/Card.astro"
import Pagination from "@/components/Pagination.astro"
import Layout from "@/layouts/Layout.astro"
import Main from "@/layouts/Main.astro"
import config from "@/site.config"
import { getPostsByTag, getUniqueTags } from "@/utils"

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts")
  const tags = getUniqueTags(posts)

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag)

    return paginate(tagPosts, {
      pageSize: config.appearance.postsPerPage,
      params: { tag },
      props: { tagName },
    })
  })
}

const { tag } = Astro.params
const { page, tagName } = Astro.props
---

<Layout footerNoMarginTop={page.lastPage > 1} title={`Tag: ${tagName} | ${config.title}`}>
  <Main pageDesc={`All the articles with the tag "${tagName}".`} pageTitle={["Tag:", tagName]} titleTransition={tag}>
    <h1 slot="title" transition:name={tag}>{`Tag:${tag}`}</h1>
    <ul>
      {page.data.map((post) => <Card {...post} />)}
    </ul>
  </Main>

  <Pagination {page} />
</Layout>
